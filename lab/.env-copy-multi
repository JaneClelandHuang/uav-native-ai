# Copy to .env and adjust as needed.
#
# Multi-drone starter config -- differs from .env-copy only in NUM_DRONES
# (3 instead of 1). Matches scripts/fleet_demo/run_fleet_demo.py, which
# expects a 3-vehicle fleet out of the box. Use this instead of .env-copy
# if you want to start with multiple vehicles rather than raising
# NUM_DRONES by hand later.

# Pinned SITL image. Students: leave as the instructor-provided GHCR tag.
# Instructor/local dev: matches whatever `docker build -t ...` tag you used.
SITL_IMAGE=ghcr.io/janeclelandhuang/uav-course-sitl:copter-4.6.3

# Which vehicle host-side tools (matplotlib_view.py, scripts/test_flight.py,
# scripts/test_circle.py, scripts/disarm.sh, scripts/verify_setup.py) talk
# to. Doesn't affect which vehicles start -- that's NUM_DRONES below. Must
# be between 1 and NUM_DRONES.
VEHICLE_ID=1

# ---- Fleet config, read by `python scripts/generate_fleet.py` ----
# That script must be re-run (it writes docker-compose.override.yml) after
# changing any of these, then `docker compose up -d` picks it up. It does
# NOT run docker compose for you -- see SETUP.md.

# Nickname of a saved spot in locations.json (lat/lon/alt live there, not
# here -- see that file to add your own). Must match a "nickname" field
# exactly; the generator lists valid nicknames if it doesn't.
CENTER_LOCATION=ND

# Starting heading (deg) for every vehicle. Not part of a location's own
# definition (a place doesn't have a heading), so it stays a separate knob.
CENTER_HEADING=0

# How many simulated vehicles to launch, 1-7 (7 is UPDATE_DRONE_COLORS'
# limit -- see drone_backend.py). 1 starts a single vehicle exactly at
# CENTER_LOCATION, matching every earlier lab. 2+ arranges NUM_DRONES
# vehicles evenly around CENTER_LOCATION on a ring -- none sit exactly on
# the center coordinate once there's more than one. Set to 3 here to match
# run_fleet_demo.py's three fixed flight scripts.
NUM_DRONES=3

# Target straight-line distance (m) between adjacent vehicles on that ring,
# only used when NUM_DRONES > 1. The generator solves for whatever ring
# radius produces this spacing at the current NUM_DRONES.
DRONE_SPACING_M=15

# Required for the new-gui viewer: also publishes DroneResponse's
# UPDATE_DRONE message on this topic (lowercase "update_drone" -- must
# match exactly what new-gui.py subscribes to; MQTT topics are
# case-sensitive). Leave unset only if you're exclusively using
# matplotlib_view.py, which doesn't need it. See ARCHITECTURE.md's
# "DroneResponse UPDATE_DRONE integration" section.
UPDATE_DRONE=update_drone
